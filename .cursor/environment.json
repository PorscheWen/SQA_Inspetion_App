{
  "name": "SQA Inspection App",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "operation-manual",
      "command": "APP_ROOT=\"$PWD\" MANUAL_SERVER_PORT=6688 python3 docs/server.py",
      "description": "Operation manual (docs) server on http://localhost:6688/docs/index.html"
    },
    {
      "name": "test-dashboard",
      "command": "APP_ROOT=\"$PWD\" FLAUIBDD_DASHBOARD_PORT=6690 python3 Automation_testcase/Project_FlaUIBDD/web_dashboard/server.py",
      "description": "FlaUI BDD test control console on http://localhost:6690/"
    }
  ],
  "ports": [
    { "name": "operation-manual", "port": 6688 },
    { "name": "test-dashboard", "port": 6690 }
  ]
}
